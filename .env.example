# Copy to `.env.local` (gitignored). Never commit real keys.

OPENROUTER_API_KEY=

# Dodo Payments — test mode while building; switch MODE=live with a live key.
DODO_PAYMENTS_API_KEY=
DODO_PAYMENTS_MODE=test
DODO_PRODUCT_ID=

# Optional: Standard Webhooks signing secret when you expose /webhooks/dodo publicly.
# DODO_PAYMENTS_WEBHOOK_KEY=
