# Copy to `.env.local` (gitignored). Never commit real keys.

# --- App (bundled into the build; public by design) ----------------------------
# Supabase → Project Settings → API Keys. Use the *publishable* key, never the secret one.
EXPO_PUBLIC_SUPABASE_URL=https://knmgvpoyzzysakpmwjbm.supabase.co
EXPO_PUBLIC_SUPABASE_KEY=

# --- Edge Function secrets (set on Supabase, not in the app) ------------------
# supabase secrets set --env-file supabase/.env.production   (or the dashboard)
#   OPENROUTER_API_KEY=
#   DODO_PAYMENTS_API_KEY=
#   DODO_PAYMENTS_MODE=test            # switch to `live` with a live key
#   DODO_PRODUCT_ID=
#   DODO_PAYMENTS_WEBHOOK_KEY=         # whsec_… from the Dodo webhook you create
#   APP_WEB_ORIGINS=                   # optional, comma-separated, for a web build's checkout return

# --- Local development server (`npm run ai:server`), used only without Supabase ---
OPENROUTER_API_KEY=
DODO_PAYMENTS_API_KEY=
DODO_PAYMENTS_MODE=test
DODO_PRODUCT_ID=
